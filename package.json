{
  "name": "quizmaker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "tsx watch --env-file-if-exists=.env --env-file-if-exists=.env.local server/index.ts",
    "dev:web": "vite",
    "build": "prisma generate && tsc -b && pnpm build:api && vite build",
    "build:api": "tsc -p tsconfig.server.json",
    "lint": "eslint .",
    "preview": "vite preview",
    "start:api": "node dist-server/server/index.js",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:local": "sh -ac 'DATABASE_URL=\"${LOCAL_DATABASE_URL:-postgresql://postgres:${POSTGRES_PASSWORD:-postgrespassword}@localhost:55432/postgres}\" prisma migrate deploy'",
    "db:seed:local": "sh -aec 'set -a; . ./.env; set +a; db_pw=\"${POSTGRES_PASSWORD:-postgrespassword}\"; PGPASSWORD=\"$db_pw\" psql -vON_ERROR_STOP=1 -f db/seeds/local.sql \"postgresql://postgres@localhost:55432/postgres\"'",
    "db:reset:local": "sh -aec 'set -a; . ./.env; set +a; db_pw=\"${POSTGRES_PASSWORD:-postgrespassword}\"; db_url=\"postgresql://postgres:$db_pw@localhost:55432/postgres\"; PGPASSWORD=\"$db_pw\" psql -vON_ERROR_STOP=1 \"$db_url\" <<\"SQL\"\nDROP SCHEMA IF EXISTS public CASCADE;\nCREATE SCHEMA public;\nGRANT ALL ON SCHEMA public TO postgres;\nGRANT ALL ON SCHEMA public TO public;\nSQL\nDATABASE_URL=\"$db_url\" prisma migrate deploy\npnpm db:seed:local'"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@sinclair/typebox": "^0.34.52",
    "@tailwindcss/vite": "^4.1.17",
    "@tanstack/react-query": "^5.101.4",
    "clsx": "^2.1.1",
    "fastify": "^5.12.1",
    "firebase": "^12.15.0",
    "firebase-admin": "^14.2.0",
    "react": "19.2.0",
    "react-confetti-explosion": "^3.0.3",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.5.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vercel/node": "^5.10.1",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.5",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "postcss": "^8.5.3",
    "prettier": "3.6.2",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.23.12",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.26.1",
    "vite": "7.2.2"
  }
}
