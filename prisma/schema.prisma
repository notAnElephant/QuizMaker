generator client {
  provider = "prisma-client-js"
  output   = "../server/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  user_id      String      @id @db.Uuid
  created_at   DateTime    @default(now()) @db.Timestamp(6)
  display_name String?
  email        String?
  quiz_plays   QuizPlay[]
  quizzes      Quiz[]
  quiz_shares  QuizShare[]

  @@map("users")
}

model Quiz {
  quiz_id           String      @id @db.Uuid
  title             String
  description       String?
  owner_id          String?     @db.Uuid
  created_at        DateTime    @default(now()) @db.Timestamp(6)
  updated_at        DateTime    @default(now()) @db.Timestamp(6)
  background_mode   String      @default("preset")
  background_preset String      @default("default")
  background_image  String?
  text_color        String      @default("#24211c")
  classic_mode      Boolean     @default(false)
  timer_enabled     Boolean     @default(true)
  timer_duration    Int         @default(2)
  owner             User?       @relation(fields: [owner_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  questions         Question[]
  quiz_plays        QuizPlay[]
  shares            QuizShare[]
  invitations       QuizInvitation[]

  @@map("quizzes")
}

enum QuizShareRole {
  VIEWER
  EDITOR
}

enum QuizInvitationDeliveryStatus {
  PENDING
  SENT
  FAILED
}

model QuizShare {
  quiz_id    String        @db.Uuid
  user_id    String        @db.Uuid
  role       QuizShareRole @default(VIEWER)
  created_at DateTime      @default(now()) @db.Timestamp(6)
  quiz       Quiz          @relation(fields: [quiz_id], references: [quiz_id], onDelete: Cascade, onUpdate: NoAction)
  user       User          @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([quiz_id, user_id])
  @@index([user_id])
  @@map("quiz_shares")
}

model QuizInvitation {
  invitation_id     String                       @id @default(uuid()) @db.Uuid
  quiz_id           String                       @db.Uuid
  email             String
  role              QuizShareRole                @default(VIEWER)
  delivery_status   QuizInvitationDeliveryStatus @default(PENDING)
  delivery_key      String                       @default(uuid()) @db.Uuid
  resend_message_id String?
  created_at        DateTime                     @default(now()) @db.Timestamp(6)
  quiz              Quiz                         @relation(fields: [quiz_id], references: [quiz_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([quiz_id, email])
  @@index([email])
  @@map("quiz_invitations")
}

model Question {
  question_id         String   @id @db.Uuid
  quiz_id             String?  @db.Uuid
  question_text       String
  question_type       String
  answer_options      String[] @default([])
  correct_answer      String?
  points              Int?     @default(1000)
  category_name       String
  reveal_answer       Boolean  @default(false)
  answer_media_type   String?
  answer_media_source String?
  quiz                Quiz?    @relation(fields: [quiz_id], references: [quiz_id], onDelete: Cascade, onUpdate: NoAction)
  answers             Answer[]

  @@map("questions")
}

model QuizPlay {
  play_id    String   @id @db.Uuid
  quiz_id    String?  @db.Uuid
  user_id    String?  @db.Uuid
  play_time  DateTime @default(now()) @db.Timestamp(6)
  score      Int?     @default(0)
  team_name  String?
  team_score Int?
  session_id String   @db.Uuid
  quiz       Quiz?    @relation(fields: [quiz_id], references: [quiz_id], onDelete: Cascade, onUpdate: NoAction)
  user       User?    @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  answers    Answer[]

  @@index([session_id], map: "quiz_plays_session_id_idx")
  @@map("quiz_plays")
}

model Answer {
  answer_id   String    @id @db.Uuid
  play_id     String?   @db.Uuid
  question_id String?   @db.Uuid
  answer_text String
  play        QuizPlay? @relation(fields: [play_id], references: [play_id], onDelete: Cascade, onUpdate: NoAction)
  question    Question? @relation(fields: [question_id], references: [question_id], onDelete: Cascade, onUpdate: NoAction)

  @@map("answers")
}
